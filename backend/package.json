    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "6.8.2",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.18",
    "@types/express": "5.0.2",
    "@types/node": "22.15.21",
    "prisma": "6.8.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "packageManager": "pnpm@10.28.2"
}
